# Вход тренажёра: сертификат Let's Encrypt для TRAINER_DOMAIN. /api и /ws — прямо в API, мимо Next:
# Next не проксирует WebSocket, а API видит настоящий IP ученика (X-Forwarded-For от Caddy).
{$TRAINER_DOMAIN} {
	encode zstd gzip
	header -Server
	handle /ws/* {
		reverse_proxy trainer-api:8000
	}
	handle_path /api/* {
		reverse_proxy trainer-api:8000
	}
	handle {
		reverse_proxy trainer-web:3000
	}
}

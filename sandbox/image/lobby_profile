# Терминал тренажёра. Подключись к своему серверу: ssh student@lab
# Интерактивный вход — приветствие и шлюз: только ssh на сервер, clear, exit (sandbox/image/lobby-gate).
case $- in
    *i*)
        echo
        echo "  Привет! Это вход в учебный центр. Здесь работает только подключение к серверу:"
        echo "      ssh student@lab"
        echo "  Пароль выдаст преподаватель. Все задания делаются уже на сервере lab."
        echo
        exec /usr/local/bin/lobby-gate ;;
esac
. /etc/profile.d/trainer-history.sh
